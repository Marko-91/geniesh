---
title: Geniesh Architecture
---
flowchart LR
  classDef adapter fill:#dce5f9,stroke:#2563eb,stroke-width:2,color:#1e293b
  classDef kernel fill:#ede9fe,stroke:#7c3aed,stroke-width:2,color:#1e293b
  classDef store fill:#fef3c7,stroke:#d97706,stroke-width:2,color:#1e293b
  classDef external fill:#d1fae5,stroke:#059669,stroke-width:2,color:#1e293b

  CLI["geniesh CLI"]
  EMBED["Embeddings"]
  LLM["LLM Runner"]
  SEARCH["Vector Search"]
  PROMPT["Prompts"]

  SCAN["Scan Files"]
  PARSE["Parse Sources"]
  GRAPH["Build Relation Graph"]
  CHUNK["Chunk Code"]
  COMMUNITY["Detect Communities"]

  SYM["Extract Symbols"]
  GREP["Grep Code"]
  GQUERY["Traverse Relations"]
  CONTEXT["Build Context"]

  GRAPH_FILE[(Relation Graph)]
  INDEX_FILE[(Vector Index)]

  OLLAMA("Ollama")
  TSP("tree-sitter")
  AG("@ast-grep")

  CLI --> SCAN
  CLI --> SYM

  SCAN --> PARSE --> GRAPH --> CHUNK
  GRAPH --> COMMUNITY

  CHUNK --> EMBED
  EMBED --> OLLAMA

  GRAPH -.-> GRAPH_FILE
  CHUNK -.-> INDEX_FILE

  EMBED --> INDEX_FILE
  INDEX_FILE --> SEARCH

  SYM --> GREP
  SYM --> GQUERY
  GRAPH_FILE -.-> GQUERY
  GREP --> CONTEXT
  GQUERY --> CONTEXT
  SEARCH --> CONTEXT

  CONTEXT --> PROMPT
  PROMPT --> LLM
  LLM --> OLLAMA

  PARSE --> TSP
  PARSE --> AG

  class CLI,EMBED,LLM,SEARCH,PROMPT adapter
  class SCAN,PARSE,GRAPH,CHUNK,COMMUNITY,SYM,GREP,GQUERY,CONTEXT kernel
  class GRAPH_FILE,INDEX_FILE store
  class OLLAMA,TSP,AG external
